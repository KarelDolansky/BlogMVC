# Copy to .env and set real values. .env is gitignored — never commit real secrets.

# Minimum 32 bytes (HMAC-SHA256). Generate one with: openssl rand -base64 48
JWT_KEY=

# MongoDB root credentials. The mongo container creates this user on first start (empty volume only),
# and the blogmvc container connects with it. The password is embedded in a connection URI, so use a
# URL-safe value. Generate one with: openssl rand -hex 32
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Optional. The container runs as Production by default. Development enables Swagger UI and the
# EF Core migrations endpoint — never use it for a deployment reachable by others.
# ASPNETCORE_ENVIRONMENT=Development
