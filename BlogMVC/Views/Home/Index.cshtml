@model List<Post>
@{
    ViewData["Title"] = "Home Page";
}

<div>
    <div class="container">
        @foreach (var post in Model)
        {
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <partial name="_PostCard" model="post"/>
                </div>
            </div>
        }
    </div>
</div>