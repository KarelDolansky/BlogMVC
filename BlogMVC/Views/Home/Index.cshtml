@model List<Post>
@{
    ViewData["Title"] = "Home Page";
}

<div class="hero">
    <h1>Posts</h1>
    <span class="hero__count">@Model.Count @(Model.Count == 1 ? "entry" : "entries")</span>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>No posts yet</h2>
        <p>Once someone publishes a post, it will show up in this list.</p>
    </div>
}
else
{
    <div class="post-index-wrap">
        <table class="post-index">
            <caption class="visually-hidden">List of published blog posts</caption>
            <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Post</th>
                <th scope="col">Author</th>
                <th scope="col">Published</th>
                <th scope="col">Status</th>
            </tr>
            </thead>
            <tbody>
            @{ var i = Model.Count; }
            @foreach (var post in Model)
            {
                <partial name="_PostCard" model="post"
                         view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })"/>
                i--;
            }
            </tbody>
        </table>
    </div>
}
