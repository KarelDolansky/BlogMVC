@model EditPostDto

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6 ">
            <a class="btn btn-outline-secondary" asp-controller="Post" asp-action="Details"
               asp-route-id="@ViewContext.RouteData.Values["id"]">Go back</a>
            <form asp-route-id="@ViewContext.RouteData.Values["id"]" asp-controller="Post" asp-action="Edit">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"/>
                    <input asp-for="Title" class="form-control">
                    <span asp-validation-for="Title"/>
                </div>
                <div class="mb-3">
                    <label asp-for="Content" class="form-label"/>
                    <textarea asp-for="Content" class="form-control">
    </textarea>
                    <span asp-validation-for="Content"/>
                </div>
                <button type="submit" class="btn btn-primary">
                    Edit
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}