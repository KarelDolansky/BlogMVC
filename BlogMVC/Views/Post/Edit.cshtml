@model EditPostDto
@{
    ViewData["Title"] = "Edit post";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a class="btn btn-outline-secondary mb-3" asp-controller="Post" asp-action="Details"
           asp-route-id="@ViewContext.RouteData.Values["id"]">&larr; Back</a>
        <div class="panel">
            <span class="panel__eyebrow">Editing</span>
            <h1>Edit post</h1>
            <form asp-route-id="@ViewContext.RouteData.Values["id"]" asp-controller="Post" asp-action="Edit">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control">
                    <span asp-validation-for="Title"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control">
                    <span asp-validation-for="Description"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control"></textarea>
                    <span asp-validation-for="Content"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
