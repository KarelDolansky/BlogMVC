@model Post
@{
    ViewData["Title"] = "Delete post";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a class="btn btn-outline-secondary mb-3" asp-controller="Home" asp-action="Index">&larr; Back to posts</a>
        <div class="panel panel--danger">
            <span class="panel__eyebrow">Delete this post?</span>
            <header class="post-header">
                <h1>@Model.Title</h1>
                <p class="lead">@Model.Description</p>
                <div class="post-byline">
                    <span class="author">@Model.Author</span>
                    <span>Published @Model.PublishDate.ToString("dd/MM/yyyy")</span>
                    @if (Model.ModifiedDate > Model.PublishDate)
                    {
                        <span><span
                                class="status-dot status-dot--updated"></span>Updated @Model.ModifiedDate.ToString("dd/MM/yyyy")</span>
                    }
                </div>
            </header>
            <p>This can't be undone. The post will be permanently removed.</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
                <button class="btn btn-danger">Delete permanently</button>
            </form>
            <a class="btn btn-outline-secondary" asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </div>
</div>
