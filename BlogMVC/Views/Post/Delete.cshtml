@model Post


<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6 ">
            <a class="btn btn-outline-secondary" asp-controller="home" asp-action="Index">Go back</a>
            <h1>@Model.Title</h1>
            <div class="border-bottom mb-3 pb-3">
                <p class="text-muted ">@Model.Author</p>
                <p class="text-muted ">@Model.PublishDate.ToString("dd/MM/yyyy")</p>
                @if (Model.ModifiedDate > Model.PublishDate)
                {
                    <p class="text-muted">@Model.ModifiedDate.ToString("dd/MM/yyyy")</p>
                }
            </div>
            <form asp-action="Delete" asp-route-id="@Model.Id">
                <button class="btn btn-danger">Delete</button>
            </form>
            <a class="btn btn-outline-secondary" asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </div>
</div>